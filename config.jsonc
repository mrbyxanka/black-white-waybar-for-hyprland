{
    "layer": "bottom",
    "position": "top",
    "margin": 5,
    
    "modules-left": [
        "hyprland/workspaces",
        "custom/sep",
        "cpu",
        "memory"
    ],

    "modules-center": [
        "custom/sep",
        "custom/clock",
        "custom/sep",
        "custom/weather",
        "custom/sep"
    ],
    
    "modules-right": [
        "tray",
        "custom/sep",
        "hyprland/language",
        "custom/notifications",
        "custom/sep",
        "pulseaudio",
        "backlight",
        "custom/sep",
        "network",
        "custom/sep",
        "battery",
        "custom/sep",
        "custom/lock"
    ],

    "network": {
        "format-wifi": "{icon} {essid}",
        "format-disconnected": "󰤭 Offline",
        "on-click": "$HOME/.config/waybar/scripts/waybar-wifi.sh",
        "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"]
    },
    "custom/weather": {
        "class": "weather",
        "exec": "curl -s 'wttr.in/Vlaardingen?format=%t'",
        "format": "󰅟 {text}",
        "interval": 300,
        "format-icons": ["󰖐"]
    },
    "battery": {
        "format": "{capacity}% {icon}",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },
    "custom/sep": {
        "format": "|",
        "tooltip": false
    },
    "custom/clock": {
        "exec": "date +'%d-%m-%y %H:%M:%S'",
        "interval" : 1,
        "tooltip": false

    },
    "cpu": {
        "interval": 1,
        "format": "  {icon0}{icon1}{icon2}{icon3} {usage:>2}%",
        "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
        "on-click": "$HOME/.config/waybar/scripts/waybar-btop.sh"

    },
    "memory": {
            "interval": 30,
        "format": "  {used:0.1f}G/{total:0.1f}G",
        "on-click": "$HOME/.config/waybar/scripts/waybar-btop.sh"

    },
    "tray": {
        "icon-size": 16
    },
    "hyprland/workspaces": {
        "format": "{name}: {icon}",
        "format-icons": {
            "active": "",
            "default": ""
        }
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "format-icons": {
            "default": ["", "", "", ""]
        },
        "on-click": "pavucontrol" 

    },
    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"]
    },
    "custom/notifications": {
        "format": "󰂚",
        "on-click": "swaync-client -t"
    },
    "custom/lock": {
        "format": "",
        "on-click": "hyprlock"
    },
    "hyprland/language": {
        "format": "{}",
        "format-en": "🇺🇸 US",
        "format-ru": "🇷🇺 RU"
    }

}
